{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/health",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "api/health.js": {
      "runtime": "edge"
    },
    "api/spin.js": {
      "runtime": "edge"
    },
    "api/image.js": {
      "runtime": "edge"
    },
    "api/lever.js": {
      "runtime": "edge"
    },
    "api/ratelimit-status.js": {
      "runtime": "edge"
    }
  }
}