# GithubSlotMachine Environment Variables
# Copy this file to .env and fill in your values

# GitHub Personal Access Token (required)
# Create a fine-grained PAT with: Contents: read & write (on this repo and profile repo)
# + Metadata: read (to list your repos)
GITHUB_PAT=your_github_token_here

# Slot Owner Configuration (optional - defaults point to simrim96)
SLOT_OWNER=simrim96
SLOT_REPO=GithubSlotMachine
PROFILE_REPO=simrim96/simrim96

# Upstash Redis (optional but recommended for performance)
# When set, state and slot.svg are cached in Redis (~10ms) instead of committing to GitHub
# IMPORTANT: Create the Upstash DB in the SAME region as your Vercel deployment
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# KV Timeout in milliseconds (default: 500ms)
# Increase this if you experience timeouts with cross-region Redis
KV_TIMEOUT_MS=500
