# ============================================================================
# GitHub Slot Machine - environment variables
# Copy this file to .env (or set the vars in your Vercel project) and fill in.
# Every value is OPTIONAL unless marked. Unset vars fall back to the defaults
# shown below, so a minimal fork only needs GITHUB_PAT to actually run.
# ============================================================================

# ---------------------------------------------------------------------------
# GitHub (required for the slot to write results back to your profile README)
# ---------------------------------------------------------------------------
# SECURITY (S4, ISSUES.md §2): use a FINE-GRAINED PAT, NOT a classic PAT.
# A classic PAT (prefix ghp_...) with the broad `repo` scope can read/write
# EVERY repo you own if it ever leaks. A fine-grained PAT (prefix
# github_pat_...) is scoped to exactly the two repos below, so a leak is
# contained. The app now DETECTS a classic/unknown PAT and warns (Sentry +
# logs); set GITHUB_PAT_REQUIRE_FINEGRAINED=true to make it refuse writes.
#
# How to create it (GitHub → Settings → Developer settings → Fine-grained
# PATs → Generate new token):
#   - Repository access: "Only select repositories" → pick BOTH:
#       • your slot repo   (GithubSlotMachine)
#       • your profile repo (<your-user>/<your-user>)
#   - Repository permissions → Contents: Read and write
#   - (No account-level `repo` scope — that's the whole point of S4)
#   - Expiration: set a rotation period (e.g. 90 days) and rotate it.
GITHUB_PAT=
# Set to "true" to refuse (fail-closed, read-only) when GITHUB_PAT is NOT a
# fine-grained token. Default empty/false = warn only.
GITHUB_PAT_REQUIRE_FINEGRAINED=

# Owner of the slot repo plus whose repos are scanned (default: simrim96)
SLOT_OWNER=simrim96

# Repo that hosts slot.svg / state.json (default: GithubSlotMachine)
SLOT_REPO=GithubSlotMachine

# Your profile README repo <user>/<user> (default: = SLOT_OWNER)
PROFILE_REPO=

# LEGACY aliases for the profile owner, read by api/lever.js and api/badge.js
# as fallback before 'simrim96'. You normally do NOT need these — set
# SLOT_OWNER/PROFILE_REPO instead. Kept for backward compatibility.
PROFILE_REPO_OWNER=
GITHUB_OWNER=

# Timeout (ms) for GitHub API calls (default: 2000)
GITHUB_API_TIMEOUT_MS=2000

# Tight timeout (ms) for CONTENT reads on the critical spin path (state.json
# when KV is off, slot config, etc.) so a slow GitHub doesn't stall the spin
# (default: 800)
GH_CONTENTS_TIMEOUT_MS=800

# Timeout (ms) for the backup PUT of slot.svg to GitHub. The write is awaited
# (not fire-and-forget) but capped so a slow GitHub cannot push the spin past
# the README cap; runs in parallel with the README PUT (default: 1500)
SLOT_SVG_GITHUB_TIMEOUT_MS=1500

# ---------------------------------------------------------------------------
# Spin behaviour / rate limiting
# ---------------------------------------------------------------------------
# Min time (ms) between two spins from the same IP (per-IP cooldown, fix S2,
# ISSUES.md). Also mirrored client-side in public/_spin-cooldown.js so the
# UI agrees on the same window (default: 3000)
SPIN_COOLDOWN_MS=3000

# ---------------------------------------------------------------------------
# Logging (api/_lib/logger.js — structured JSON lines on stdout/stderr)
# ---------------------------------------------------------------------------
# Minimum level emitted: debug < info < warn < error. Unknown values fall back
# to info/warn/error (default: info)
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Upstash Redis (optional, but recommended - spins ~10-20ms same-region)
# Set the standalone pair (UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN),
# OR the Vercel KV pair (KV_REST_API_URL + KV_REST_API_TOKEN), to enable Redis.
# If neither pair is set, the code falls back to the GitHub Contents API.
# The Vercel Upstash Redis / KV storage integration sets the KV_REST_API_*
# vars automatically - either approach enables Redis.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# OPTIONAL. Read-only Upstash token. If set, it is used as a fallback for the
# read-path token when KV_REST_API_TOKEN is absent. Leave empty in most
# setups: not needed when KV_REST_API_TOKEN (or the standalone pair) is set.
KV_REST_API_READ_ONLY_TOKEN=
# KV network timeout (ms) before falling back to GitHub (default: 500)
KV_TIMEOUT_MS=500

# ---------------------------------------------------------------------------
# KV circuit breaker (api/_lib/kv.js)
# ---------------------------------------------------------------------------
# If Redis fails this many times consecutively, the circuit breaker OPENS and
# Redis is disabled (silent fallback to GitHub) for the reset window below.
# Health checks then report the breaker state (default: 5)
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# How long (ms) the breaker stays open before trying Redis again
# (default: 60000 = 60s)
CIRCUIT_BREAKER_RESET_MS=60000

# ---------------------------------------------------------------------------
# State sync Redis → GitHub (api/_lib/state.js, improvements M4/R2)
# ---------------------------------------------------------------------------
# The async state.json backup on GitHub is fire-and-forget; if it fails this
# many times CONSECUTIVELY an explicit alert (log + Sentry) is raised once so
# the drift is noticed (default: 5)
STATE_SYNC_FAILURE_ALERT_THRESHOLD=5
# Retries for a failed state write, with exponential backoff (default: 3)
STATE_SYNC_MAX_RETRIES=3
# Base backoff (ms) for the retries above: attempt n waits base × 2^n
# (default: 200 → 200, 400, 800ms ≈ 1.4s max)
STATE_SYNC_BACKOFF_BASE_MS=200

# Comma-separated list of origins allowed to call /api/spin cross-origin.
# If the incoming Origin is in this list, ACAO is echoed back; otherwise no
# ACAO header is emitted (browser blocks cross-origin reads, direct nav works).
# Default if unset: the Vercel app domain + common localhost dev ports below.
ALLOWED_CORS_ORIGINS=https://github-slot-machine.vercel.app,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Comma-separated allowlist of HOSTS the /api/spin ?redirect= target may point
# to (open-redirect protection, fix S1, ISSUES.md). A redirect to a host NOT in
# this list is always rejected and the spin falls back to the computed
# destination. Setting this REPLACES the default list below — forks on a custom
# domain must add theirs. Relative URLs (same-origin) are always allowed.
# Default: github-slot-machine.vercel.app, github.com, localhost, 127.0.0.1
SLOT_ALLOWED_HOSTS=https://github-slot-machine.vercel.app,github.com,localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Graceful shutdown (api/_lib/shutdown.js — SIGTERM/SIGINT handling)
# ---------------------------------------------------------------------------
# Max time (ms) to wait for in-flight operations on SIGTERM before forcing
# exit (default: 5000)
SHUTDOWN_TIMEOUT_MS=5000
# Set to "true" for verbose shutdown logging (default: false)
SHUTDOWN_VERBOSE=false

# ---------------------------------------------------------------------------
# Sentry (optional - error monitoring and tracing)
# ---------------------------------------------------------------------------
# Get your DSN from https://sentry.io/
SENTRY_DSN=

# Sample rates (0 = off). Read by sentry.config.js. The NAMES must match the
# code (SENTRY_TRACES_SAMPLE_RATE / SENTRY_PROFILES_SAMPLE_RATE), otherwise the
# values are silently ignored and tracing stays at 0.
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Error sampling rate for captureException calls (0 = no errors sent, 1 = all).
# Defaults to 0.1 (10%) to balance observability with cost control at scale.
# Override with SENTRY_ERROR_SAMPLE_RATE (0.0–1.0).
SENTRY_ERROR_SAMPLE_RATE=0.1

# Set to "true" to enable Sentry debug logging (default: off)
SENTRY_DEBUG=false

# ---------------------------------------------------------------------------
# JWT (used by api/_lib/jwt-config.js — needed once auth endpoints are wired)
# ---------------------------------------------------------------------------
# Secret used to sign/verify tokens. REQUIRED in production: if missing (or
# still set to the dev placeholder) when NODE_ENV=production, the JWT config
# module throws and refuses to sign. The value below is a DEV-ONLY fallback
# for local development/tests — never deploy with it. Generate a real one:
#   openssl rand -base64 48
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
# Signing algorithm (default: HS256). For RSA/EC/EdDSA put the PEM key material
# in JWT_SECRET and set the matching algorithm (e.g. RS256).
JWT_ALGORITHM=HS256
# Optional issuer claim written into tokens and checked on verify
JWT_ISSUER=github-slot-machine
# Access token lifetime: seconds (900) or duration string ("15m", "1h")
JWT_ACCESS_TOKEN_TTL=15m
# Refresh token lifetime: seconds or duration string (e.g. "7d")
JWT_REFRESH_TOKEN_TTL=7d

# ---------------------------------------------------------------------------
# Admin login (POST /api/auth/login)
# ---------------------------------------------------------------------------
# Credenziali dell'amministratore verificate dall'endpoint di login. NESSUN
# default: se non configurate, il login risponde sempre 401 (fail-closed).
# Usa una password forte generata, es. `openssl rand -base64 24`.
AUTH_USERNAME=
AUTH_PASSWORD=

# ---------------------------------------------------------------------------
# Vercel Cron (GET /api/cache-refresh giornaliero `0 1 * * *` — ISSUE-N6;
# il piano Hobby di Vercel ammette solo cron con frequenza massima giornaliera)
# ---------------------------------------------------------------------------
# Secret condiviso tra i cron job Vercel e l'endpoint /api/cache-refresh.
# Se definito nel progetto, Vercel aggiunge automaticamente l'header
# "Authorization: Bearer <CRON_SECRET>" a ogni richiesta dei cron job
# (vedi https://vercel.com/docs/cron-jobs). L'endpoint accetta GET solo se
# il secret corrisponde (confronto timing-safe); in alternativa si può
# passare l'header "x-cron-secret". Senza questa env il GET /api/cache-refresh
# risponde 401 (fail-closed): il cron non parte finché non la imposti.
# Generane uno con:  openssl rand -base64 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Local development (scripts/ + Playwright E2E) — dev-only, not needed on Vercel
# ---------------------------------------------------------------------------
# Port for the local preview/dev servers (scripts/dev-server.mjs,
# scripts/preview-server.mjs) (default: 3000)
PORT=3000
# Base URL used by Playwright E2E (playwright.config.js) to reach the running
# app; overrides the derived http://localhost:${PORT} (default: derived)
BASE_URL=
# Standard CI convention (set automatically by GitHub Actions/CI providers):
# Playwright then forbids focused tests, caps retries/workers and reuses the
# already-running server. You normally never set this by hand.
CI=false

# ---------------------------------------------------------------------------
# Set AUTOMATICALLY by Vercel - do NOT set these manually in a Vercel deploy:
#   VERCEL, VERCEL_ENV, NODE_ENV
# ---------------------------------------------------------------------------
