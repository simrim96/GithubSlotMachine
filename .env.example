# ============================================================================
# GitHub Slot Machine - environment variables
# Copy this file to .env (or set the vars in your Vercel project) and fill in.
# Every value is OPTIONAL unless marked. Unset vars fall back to the defaults
# shown below, so a minimal fork only needs GITHUB_PAT to actually run.
# ============================================================================

# ---------------------------------------------------------------------------
# GitHub (required for the slot to write results back to your profile README)
# ---------------------------------------------------------------------------
# Fine-grained PAT with Contents: read and write on the slot repo AND your
# profile repo (<your-user>/<your-user>), plus Metadata: read.
# Without it the slot can only READ - it will not update your README.
GITHUB_PAT=

# Owner of the slot repo plus whose repos are scanned (default: simrim96)
SLOT_OWNER=simrim96

# Repo that hosts slot.svg / state.json (default: GithubSlotMachine)
SLOT_REPO=GithubSlotMachine

# Your profile README repo <user>/<user> (default: = SLOT_OWNER)
PROFILE_REPO=

# Timeout (ms) for GitHub API calls (default: 5000)
GITHUB_API_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Upstash Redis (optional, but recommended - spins ~10-20ms same-region)
# Set BOTH standalone vars to enable Redis; if absent, the code falls back to
# the GitHub Contents API. The Vercel Upstash Redis / KV storage integration
# sets the KV_REST_API_* vars instead - either approach enables Redis.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
# KV network timeout (ms) before falling back to GitHub (default: 500)
KV_TIMEOUT_MS=500

# Comma-separated list of origins allowed to call /api/spin cross-origin.
# If the incoming Origin is in this list, ACAO is echoed back; otherwise no
# ACAO header is emitted (browser blocks cross-origin reads, direct nav works).
# Default if unset: the Vercel app domain + common localhost dev ports below.
ALLOWED_CORS_ORIGINS=https://github-slot-machine.vercel.app,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Sentry (optional - error monitoring and tracing)
# ---------------------------------------------------------------------------
# Get your DSN from https://sentry.io/
SENTRY_DSN=

# Sample rates (0 = off). Read by sentry.config.js. The NAMES must match the
# code (SENTRY_TRACES_SAMPLE_RATE / SENTRY_PROFILES_SAMPLE_RATE), otherwise the
# values are silently ignored and tracing stays at 0.
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Set to "true" to enable Sentry debug logging (default: off)
SENTRY_DEBUG=false

# ---------------------------------------------------------------------------
# Set AUTOMATICALLY by Vercel - do NOT set these manually in a Vercel deploy:
#   VERCEL, VERCEL_ENV, NODE_ENV
# ---------------------------------------------------------------------------
