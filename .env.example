# ============================================================================
# GitHub Slot Machine - environment variables
# Copy this file to .env (or set the vars in your Vercel project) and fill in.
# Every value is OPTIONAL unless marked. Unset vars fall back to the defaults
# shown below, so a minimal fork only needs GITHUB_PAT to actually run.
# ============================================================================

# ---------------------------------------------------------------------------
# GitHub (required for the slot to write results back to your profile README)
# ---------------------------------------------------------------------------
# SECURITY (S4, ISSUES.md §2): use a FINE-GRAINED PAT, NOT a classic PAT.
# A classic PAT (prefix ghp_...) with the broad `repo` scope can read/write
# EVERY repo you own if it ever leaks. A fine-grained PAT (prefix
# github_pat_...) is scoped to exactly the two repos below, so a leak is
# contained. The app now DETECTS a classic/unknown PAT and warns (Sentry +
# logs); set GITHUB_PAT_REQUIRE_FINEGRAINED=true to make it refuse writes.
#
# How to create it (GitHub → Settings → Developer settings → Fine-grained
# PATs → Generate new token):
#   - Repository access: "Only select repositories" → pick BOTH:
#       • your slot repo   (GithubSlotMachine)
#       • your profile repo (<your-user>/<your-user>)
#   - Repository permissions → Contents: Read and write
#   - (No account-level `repo` scope — that's the whole point of S4)
#   - Expiration: set a rotation period (e.g. 90 days) and rotate it.
GITHUB_PAT=
# Set to "true" to refuse (fail-closed, read-only) when GITHUB_PAT is NOT a
# fine-grained token. Default empty/false = warn only.
GITHUB_PAT_REQUIRE_FINEGRAINED=

# Owner of the slot repo plus whose repos are scanned (default: simrim96)
SLOT_OWNER=simrim96

# Repo that hosts slot.svg / state.json (default: GithubSlotMachine)
SLOT_REPO=GithubSlotMachine

# Your profile README repo <user>/<user> (default: = SLOT_OWNER)
PROFILE_REPO=

# Timeout (ms) for GitHub API calls (default: 5000)
GITHUB_API_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Upstash Redis (optional, but recommended - spins ~10-20ms same-region)
# Set the standalone pair (UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN),
# OR the Vercel KV pair (KV_REST_API_URL + KV_REST_API_TOKEN), to enable Redis.
# If neither pair is set, the code falls back to the GitHub Contents API.
# The Vercel Upstash Redis / KV storage integration sets the KV_REST_API_*
# vars automatically - either approach enables Redis.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# OPTIONAL. Read-only Upstash token. If set, it is used as a fallback for the
# read-path token when KV_REST_API_TOKEN is absent. Leave empty in most
# setups: not needed when KV_REST_API_TOKEN (or the standalone pair) is set.
KV_REST_API_READ_ONLY_TOKEN=
# KV network timeout (ms) before falling back to GitHub (default: 500)
KV_TIMEOUT_MS=500

# Comma-separated list of origins allowed to call /api/spin cross-origin.
# If the incoming Origin is in this list, ACAO is echoed back; otherwise no
# ACAO header is emitted (browser blocks cross-origin reads, direct nav works).
# Default if unset: the Vercel app domain + common localhost dev ports below.
ALLOWED_CORS_ORIGINS=https://github-slot-machine.vercel.app,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Sentry (optional - error monitoring and tracing)
# ---------------------------------------------------------------------------
# Get your DSN from https://sentry.io/
SENTRY_DSN=

# Sample rates (0 = off). Read by sentry.config.js. The NAMES must match the
# code (SENTRY_TRACES_SAMPLE_RATE / SENTRY_PROFILES_SAMPLE_RATE), otherwise the
# values are silently ignored and tracing stays at 0.
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Error sampling rate for captureException calls (0 = no errors sent, 1 = all).
# Defaults to 0.1 (10%) to balance observability with cost control at scale.
# Override with SENTRY_ERROR_SAMPLE_RATE (0.0–1.0).
SENTRY_ERROR_SAMPLE_RATE=0.1

# Set to "true" to enable Sentry debug logging (default: off)
SENTRY_DEBUG=false

# ---------------------------------------------------------------------------
# JWT (used by api/_lib/jwt-config.js — needed once auth endpoints are wired)
# ---------------------------------------------------------------------------
# Secret used to sign/verify tokens. REQUIRED in production: if missing (or
# still set to the dev placeholder) when NODE_ENV=production, the JWT config
# module throws and refuses to sign. The value below is a DEV-ONLY fallback
# for local development/tests — never deploy with it. Generate a real one:
#   openssl rand -base64 48
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
# Signing algorithm (default: HS256). For RSA/EC/EdDSA put the PEM key material
# in JWT_SECRET and set the matching algorithm (e.g. RS256).
JWT_ALGORITHM=HS256
# Optional issuer claim written into tokens and checked on verify
JWT_ISSUER=github-slot-machine
# Access token lifetime: seconds (900) or duration string ("15m", "1h")
JWT_ACCESS_TOKEN_TTL=15m
# Refresh token lifetime: seconds or duration string (e.g. "7d")
JWT_REFRESH_TOKEN_TTL=7d

# ---------------------------------------------------------------------------
# Admin login (POST /api/auth/login)
# ---------------------------------------------------------------------------
# Credenziali dell'amministratore verificate dall'endpoint di login. NESSUN
# default: se non configurate, il login risponde sempre 401 (fail-closed).
# Usa una password forte generata, es. `openssl rand -base64 24`.
AUTH_USERNAME=
AUTH_PASSWORD=

# ---------------------------------------------------------------------------
# Set AUTOMATICALLY by Vercel - do NOT set these manually in a Vercel deploy:
#   VERCEL, VERCEL_ENV, NODE_ENV
# ---------------------------------------------------------------------------
