{
  "name": "github-slot-machine",
  "version": "1.0.0",
  "description": "An animated, recruiter-friendly slot machine for your GitHub profile README. Reels of your stack, fun facts, and auto-redirect to your best repo in the winning language.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "vercel dev",
    "dev": "vercel dev",
    "preview": "node scripts/preview-server.mjs",
    "build": "echo 'No build step required for serverless functions'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "security": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@sentry/node": "^10.65.0",
    "@sentry/vercel-edge": "^10.66.0",
    "@upstash/redis": "^1.38.0",
    "@vercel/functions": "^3.7.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "3.9.5",
    "vercel": "^56.0.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "github",
    "profile-readme",
    "slot-machine",
    "svg",
    "vercel",
    "portfolio"
  ],
  "license": "MIT",
  "overrides": {
    "tar": "7.5.20"
  }
}
